---
import Layout from '../components/Layout.astro';
---

<Layout title="Calvin Chun Wai Tai | Contact" description="Contact and LinkedIn">
  <section class="mx-auto max-w-4xl px-6 md:px-10 py-20 md:py-28">
    <h1 class="text-5xl sm:text-6xl md:text-7xl leading-none">Contact</h1>
    <p class="mt-6 text-lg text-black/80 max-w-2xl">
      Let's build something. I'm always open to a good conversation, so please don't hesitate to send a message.
    </p>

    <div class="mt-12 space-y-4 text-lg text-black/80">
      <p>
        <span class="font-heading">Click to send email directly:</span> <a
          href="mailto:calvin729@gmail.com"
          class="underline decoration-4 decoration-violent-red hover:text-violent-red"
        >
          calvin729@gmail.com
        </a>
      </p>
      <p>
        <span class="font-heading">Click to visit my:</span> <a
          href="https://www.linkedin.com/in/calvintai/"
          target="_blank"
          rel="noreferrer"
          class="underline decoration-4 decoration-transparent hover:decoration-violent-red hover:text-violent-red"
        >
          LinkedIn Profile
        </a>
      </p>
    </div>

    <form id="contact-form" class="mt-14 border-4 border-black p-6 md:p-8 space-y-5" action="#" method="post">
      <div>
        <label for="name" class="block font-heading text-lg mb-2">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="[Your Name]"
          required
          class="w-full border-2 border-black px-4 py-3 focus:outline-none focus:border-violent-red"
        />
      </div>

      <div>
        <label for="email" class="block font-heading text-lg mb-2">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="[your@email.com]"
          required
          class="w-full border-2 border-black px-4 py-3 focus:outline-none focus:border-violent-red"
        />
      </div>

      <div>
        <label for="message" class="block font-heading text-lg mb-2">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="[Insert message here]"
          required
          class="w-full border-2 border-black px-4 py-3 focus:outline-none focus:border-violent-red"
        ></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex items-center border-4 border-violent-red px-7 py-3 font-heading text-lg hover:bg-violent-red hover:text-white"
      >
        Send Message
      </button>
    </form>

    <div id="form-success-message" class="hidden mt-8 font-heading text-lg text-black">
      Successfully sent! Thank You and I will get back to you as soon as possible.
    </div>

    <script>
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const successMessage = document.getElementById('form-success-message');

      if (form && successMessage) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());
          const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

          if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = 'Sending...';
          }

          try {
            const response = await fetch('https://formsubmit.co/ajax/calvin729@gmail.com', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(data)
            });

            if (response.ok) {
              successMessage.classList.remove('hidden');
              form.reset();
            } else {
              alert('Failed to send message. Please try again or email directly.');
            }
          } catch (error) {
            console.error('Error submitting form:', error);
            alert('Failed to send message. Please try again or email directly.');
          } finally {
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.textContent = 'Send Message';
            }
          }
        });
      }
    </script>
  </section>
</Layout>
