---
import Layout from '../components/Layout.astro';
---

<Layout title="Calvin Chun Wai Tai | Home" description="Career snapshot and portfolio intro">
  <section class="mx-auto max-w-6xl px-6 md:px-10 pt-20 md:pt-28 pb-16 md:pb-24">
    <p class="font-heading text-sm md:text-base tracking-widest mb-6">Personal Portfolio</p>

    <h1 class="text-5xl sm:text-6xl md:text-8xl leading-[0.95]">Calvin Chun Wai Tai</h1>

    <div class="mt-5 h-2 w-28 md:w-40 bg-violent-red" aria-hidden="true"></div>

    <p class="mt-10 max-w-2xl text-lg md:text-xl leading-relaxed text-black/80">
      [Insert Executive Summary Here] Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus non
      sem ac risus elementum consequat. Integer et magna in nunc feugiat gravida.
    </p>

    <div class="mt-12 flex flex-col sm:flex-row gap-4">
      <a
        href="/projects"
        class="inline-flex items-center justify-center border-4 border-black px-7 py-3 font-heading text-lg hover:bg-black hover:text-white"
      >
        View Projects
      </a>
      <a
        href="/contact"
        class="inline-flex items-center justify-center border-4 border-violent-red px-7 py-3 font-heading text-lg hover:bg-violent-red hover:text-white"
      >
        Get In Touch
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 md:px-10 py-16 md:py-24 border-t-4 border-black">
    <h2 class="text-3xl md:text-5xl mb-6">About Me / Career Snapshot</h2>
    <p class="max-w-3xl text-base md:text-lg leading-relaxed text-black/80">
      [Insert Career Snapshot Here] Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras suscipit,
      sem ut luctus sollicitudin, magna eros facilisis urna, vitae egestas lorem neque vel lectus.
      Pellentesque habitant morbi tristique senectus et netus et malesuada fames.
    </p>
  </section>
</Layout>
