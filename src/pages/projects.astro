---
import Layout from '../components/Layout.astro';

const projects = [
  {
    title: '[Insert Project Name 01]',
    category: '[Brand & Communications]',
    summary: '[Insert Brand & Communications Project Details]',
    href: '#',
  },
  {
    title: '[Insert Project Name 02]',
    category: '[Digital Experience]',
    summary: '[Insert Product / UX Case Study Details]',
    href: '#',
  },
  {
    title: '[Insert Project Name 03]',
    category: '[Campaign Strategy]',
    summary: '[Insert Cross-Channel Campaign Details]',
    href: '#',
  },
  {
    title: '[Insert Project Name 04]',
    category: '[Content Systems]',
    summary: '[Insert Content Architecture Details]',
    href: '#',
  },
];
---

<Layout title="Calvin Chun Wai Tai | Projects" description="Selected case studies and portfolio items">
  <section class="bg-black text-white">
    <div class="mx-auto max-w-6xl px-6 md:px-10 py-20 md:py-28">
      <h1 class="text-5xl sm:text-6xl md:text-7xl leading-none">Projects</h1>
      <p class="mt-6 max-w-2xl text-white/80 text-lg">
        [Insert Projects Intro Here] Lorem ipsum dolor sit amet, consectetur adipiscing elit.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          projects.map((project) => (
            <article class="group bg-white text-black border-4 border-white hover:border-violent-red transition-colors duration-200">
              <a href={project.href} class="block p-6 md:p-8">
                <p class="font-heading text-sm tracking-widest text-black/60">{project.category}</p>
                <h2 class="mt-3 text-3xl leading-tight">{project.title}</h2>
                <p class="mt-4 text-black/75 leading-relaxed">{project.summary}</p>
                <span class="mt-8 inline-block font-heading text-base group-hover:text-violent-red">
                  View Case Study →
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
